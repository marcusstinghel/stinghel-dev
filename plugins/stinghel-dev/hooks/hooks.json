{
  "description": "Gates de qualidade do stinghel-dev.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/plan-guard.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
